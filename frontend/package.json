{
    "name": "document-platform-web",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24.19.0 <25"
    },
    "scripts": {
        "dev": "vite build --watch",
        "build": "tsc --noEmit && vite build",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "lucide-react": "1.72.0"
    },
    "devDependencies": {
        "vite": "8.3.8",
        "@vitejs/plugin-react": "6.3.0",
        "typescript": "6.0.3",
        "vitest": "5.1.0",
        "jsdom": "31.0.0",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/node": "24.19.2",
        "@testing-library/react": "16.3.3",
        "@testing-library/dom": "10.4.2",
        "@testing-library/user-event": "14.6.10",
        "@testing-library/jest-dom": "7.0.1",
        "eslint": "10.14.0",
        "@eslint/js": "10.0.1",
        "typescript-eslint": "8.72.2",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.14.0",
        "prettier": "3.10.1"
    },
    "overrides": {
        "minimatch": "11.0.1"
    }
}
