# Development settings only. Copy to .env from the repository root.
# No passwords belong here: bootstrap generates random credentials in ignored files.
# Development certificates are valid for localhost/api, postgres and rabbitmq.
APP_API_HOST=127.0.0.1
APP_API_PORT=8443
APP_TLS_CA_FILE=.local/certs/ca.crt
APP_API_CERT_FILE=.local/certs/api.crt
APP_API_KEY_FILE=.local/certs/api.key
APP_DB_HOST=postgres
APP_DB_PORT=5432
APP_DB_NAME=document_platform
APP_DB_USER=document_app
APP_DB_PASSWORD_FILE=.local/secrets/db_app_password
APP_BROKER_HOST=rabbitmq
APP_BROKER_PORT=5671
APP_BROKER_USER=document_app
APP_BROKER_VHOST=document_platform
APP_BROKER_PASSWORD_FILE=.local/secrets/broker_app_password
# Docker and provisioning real PostgreSQL/RabbitMQ services belong to the final feature.
# /ready returns 503 until configured TLS services are available; /health is independent.
