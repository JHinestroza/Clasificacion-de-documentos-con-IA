# Local development only; .env is ignored and contains operational secrets.
# Never copy real credentials into this example.
APP_API_HOST=127.0.0.1
APP_API_PORT=8443
APP_TLS_CA_FILE=.local/certs/ca.crt
APP_API_CERT_FILE=.local/certs/api.crt
APP_API_KEY_FILE=.local/certs/api.key
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=document_platform
APP_DB_USER=document_app
APP_DB_ADMIN_USER=postgres
# Empty on purpose: bootstrap generates distinct DB/broker secrets in ignored .env.
APP_DB_ADMIN_PASSWORD=
APP_DB_PASSWORD=
APP_BROKER_HOST=localhost
APP_BROKER_PORT=5671
APP_BROKER_USER=document_app
APP_BROKER_VHOST=document_platform
APP_BROKER_PASSWORD=
# Set a unique random initial portal password in .env before explicit bootstrap.
# This credential is distinct from the PostgreSQL administrator password.
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_AUTH_ALLOWED_ORIGINS='["https://localhost:8443","https://127.0.0.1:8443"]'
APP_AUTH_IDLE_SECONDS=1800
APP_AUTH_ABSOLUTE_SECONDS=28800
APP_AUTH_LOGIN_WINDOW_SECONDS=900
APP_AUTH_LOGIN_MAX_ATTEMPTS=5
APP_AUTH_HASH_CONCURRENCY=2
# PostgreSQL and RabbitMQ must be configured for verified TLS; see docs/identity-local.md.
# Docker/Linux workers remain deferred to the final feature.

# Compiled public React assets; build before API startup. No frontend secrets.
APP_WEB_DIST_DIR=frontend/dist
